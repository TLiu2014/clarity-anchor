{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "bedrock-agentcore.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "REPLACE_ACCOUNT_ID" },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:bedrock-agentcore:REPLACE_REGION:REPLACE_ACCOUNT_ID:*"
        }
      }
    }
  ]
}
